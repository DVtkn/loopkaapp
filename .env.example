# Environment mode: Set to "production" in Cloud Run / hosting to enforce strict fail-fast PostgreSQL mode and disable ephemeral file fallback.
# In "production", DATABASE_URL is strictly required, and any DB failure returns HTTP 503 (DB_UNAVAILABLE).
NODE_ENV="production"

# PostgreSQL / Neon Database Connection String (REQUIRED in production)
DATABASE_URL=""
NEON_DATABASE_URL=""

# GROQ_API_KEY: Required for production AI psychologist (Sova). Models: llama-3.3-70b-versatile, llama-3.1-8b-instant.
# Without this key in production, the app operates in offline fallback mode (generateSmartPsychologistReply).
GROQ_API_KEY=""

# GEMINI_API_KEY: Secondary AI engine for Gemini API calls
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# VAPID Keys for Web Push Notifications (iOS Safari PWA & Android / Chrome)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@loopapp.io"

# APP_URL: Base URL of your deployed application
APP_URL=""

# Cloud SQL PostgreSQL Connection details (alternative)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# JWT Secret for session authentication tokens
JWT_SECRET=""
